{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "build",

  "share": "manual",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 14000
  },

  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "dotnet build": "allow",
      "dotnet build *": "allow",
      "dotnet test": "allow",
      "dotnet test *": "allow",
      "dotnet run": "allow",
      "dotnet run *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find": "allow",
      "find *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny"
    }
  }
}

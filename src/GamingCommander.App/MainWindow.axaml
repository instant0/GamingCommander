<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GamingCommander.UI.ViewModels"
        xmlns:svc="using:GamingCommander.App.Services"
        x:Class="GamingCommander.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        mc:Ignorable="d"
        Title="GamingCommander"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        CanResize="True"
        d:DesignWidth="1280"
        d:DesignHeight="820">
  <Window.Resources>
    <svc:HexToBrushConverter x:Key="HexToBrush" />
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
    <Border Grid.Row="0" Classes="pane" Padding="12" Margin="0,0,0,10">
      <StackPanel Spacing="4">
        <TextBlock Text="GamingCommander" FontWeight="Bold" FontSize="{DynamicResource FontSizeAppTitle}" Foreground="{DynamicResource TextAccent}" />
        <TextBlock Text="{Binding InteractionHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSuccess}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,6,*">
      <Border Grid.Column="0" Classes="pane">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Classes="pane-header" Text="{Binding LeftPaneTitle}" />
            <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='({0} items)'}"
                       Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                       IsVisible="{Binding !IsAtRootLevel}" />
          </Grid>
          <ListBox Grid.Row="1"
                   x:Name="LeftListBox"
                   ItemsSource="{Binding Items}"
                   SelectedIndex="{Binding SelectedIndex}"
                   DoubleTapped="LeftListBox_DoubleTapped"
                   Margin="0,2,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ShellPaneItemViewModel">
                <Border BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="0,0,0,1" Padding="4,3">
                  <!-- Plan 117: Badge | Title+subtitle | Path | Scanning -->
                  <Grid ColumnDefinitions="80,1*,Auto,Auto">
                    <Border Grid.Column="0"
                            Background="{Binding StoreBadge.Background, Converter={StaticResource HexToBrush}}"
                            CornerRadius="3" Padding="5,1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MinWidth="72"
                            IsVisible="{Binding StoreBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding StoreBadge.Name}"
                                 Foreground="{Binding StoreBadge.Foreground, Converter={StaticResource HexToBrush}}"
                                 FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{DynamicResource FontSizeItem}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Foreground="{Binding ItemStatusColor, Converter={StaticResource HexToBrush}}" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}"
                                 FontSize="{DynamicResource FontSizeItem}" VerticalAlignment="Center"
                                 Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LeftPath}"
                               Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               MaxWidth="280" TextAlignment="Right" Margin="6,0" />
                    <TextBlock Grid.Column="3" Text="{Binding ScanningBadge}"
                               Foreground="{DynamicResource TextHighlight}" FontSize="{DynamicResource FontSizeLabel}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AccentBorder}"
                    ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="pane">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Classes="pane-header" Text="{Binding RightPaneTitle}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4" Margin="0,4,8,0">
            <TextBlock Text="Name" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" />
            <TextBlock Text="{Binding DetailsName}" FontWeight="Bold" FontSize="{DynamicResource FontSizeHeader}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" />

            <TextBlock Text="Path" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" Margin="0,12,0,0"
                       IsVisible="{Binding DetailsGameFolderClickable, Converter={x:Static BoolConverters.Not}}" />
            <TextBlock Text="{Binding DetailsPath}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeLabel}"
                       Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"
                       IsVisible="{Binding DetailsGameFolderClickable, Converter={x:Static BoolConverters.Not}}" />
            <TextBlock Text="Game folder (click to open)"
                       Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" Margin="0,12,0,0"
                       IsVisible="{Binding DetailsGameFolderClickable}" />
            <TextBlock Text="{Binding DetailsGameFolder}"
                       Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                       TextWrapping="Wrap" Cursor="Hand" Margin="12,0,0,0"
                       PointerPressed="OpenGameFolder_PointerPressed"
                       IsVisible="{Binding DetailsGameFolderClickable}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                        IsVisible="{Binding HasGameSelected}">
              <TextBlock Text="{Binding DetailsTypeLine}" Foreground="{DynamicResource TextMuted}"
                         FontSize="{DynamicResource FontSizeLabel}" VerticalAlignment="Center" />
              <Border Background="{Binding DetailsStoreBadge.Background, Converter={StaticResource HexToBrush}}"
                      CornerRadius="3" Padding="6,1" VerticalAlignment="Center" MinWidth="72"
                      IsVisible="{Binding HasStoreBadge}">
                <TextBlock Text="{Binding DetailsStoreBadge.Name}"
                           Foreground="{Binding DetailsStoreBadge.Foreground, Converter={StaticResource HexToBrush}}"
                           FontSize="10" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="Change"
                         Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeSmall}"
                         Cursor="Hand" TextDecorations="Underline" VerticalAlignment="Center"
                         PointerPressed="ChangeType_PointerPressed" />
            </StackPanel>
            <TextBlock Text="{Binding DetailsDetectedOn, StringFormat='Detected on: {0}'}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                       Margin="0,4,0,0"
                       IsVisible="{Binding HasDetectedOn}" />

            <TextBlock Text="Platform ID" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" Margin="0,12,0,0"
                       IsVisible="{Binding HasPlatformId}" />
            <TextBlock Text="{Binding DetailsPlatformId}" Foreground="{DynamicResource TextSuccess}" FontSize="{DynamicResource FontSizeBody}"
                       Margin="12,0,0,0"
                       IsVisible="{Binding HasPlatformId}" />

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0"
                        IsVisible="{Binding HasPlatformStatus}">
              <TextBlock Text="Status" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" />
              <TextBlock Text="{Binding DetailsPlatformStatus}" FontSize="{DynamicResource FontSizeLabel}" FontWeight="Bold"
                         Foreground="{Binding DetailsPlatformStatusColor, Converter={StaticResource HexToBrush}}" />
            </StackPanel>

            <TextBlock Text="{Binding DetailsPlatformStatusDetail}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                       Margin="12,2,0,0" IsVisible="{Binding HasPlatformStatusDetail}" />
            <TextBlock Text="Write Steam ACF (needs AppID — F3 first)"
                       Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                       Margin="12,4,0,0" Cursor="Hand" TextWrapping="Wrap"
                       PointerPressed="WriteSteamAcf_PointerPressed"
                       IsVisible="{Binding IsSteamOrphaned}" />
            <TextBlock Text="Write Epic .item (one per Epic launch — then Update)"
                       Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                       Margin="12,4,0,0" Cursor="Hand" TextWrapping="Wrap"
                       PointerPressed="WriteEpicItem_PointerPressed"
                       IsVisible="{Binding IsEpicOrphaned}" />

            <!-- B33: Tags -->
            <StackPanel IsVisible="{Binding HasTags}" Margin="0,12,0,0">
              <TextBlock Text="Tags" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding DetailsTagBadges}" Margin="12,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TagBadgeViewModel">
                    <Border Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                            CornerRadius="4" Padding="6,2" Margin="2"
                            Cursor="Hand" Tag="{Binding Name}"
                            PointerPressed="TagBadgePressed">
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{Binding Foreground, Converter={StaticResource HexToBrush}}"
                                 FontSize="11" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Plan 119: sidecar extras — hidden when games_metadata.json has no row -->
            <StackPanel IsVisible="{Binding HasMetadataExtras}" Margin="0,12,0,0" Spacing="4">
              <TextBlock Text="Metadata" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" />
              <StackPanel Margin="12,0,0,0" Spacing="4">
                <TextBlock Text="{Binding DetailsDeveloper, StringFormat='Developer: {0}'}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"
                           IsVisible="{Binding DetailsDeveloper, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsPublisher, StringFormat='Publisher: {0}'}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"
                           IsVisible="{Binding DetailsPublisher, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsReleaseDate, StringFormat='Released: {0}'}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"
                           IsVisible="{Binding DetailsReleaseDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsMetacritic, StringFormat='Metacritic: {0}'}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"
                           IsVisible="{Binding DetailsMetacritic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsPcgwUrl}"
                           Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsPcgwUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasMetadataDetails}" Margin="0,12,0,0" Spacing="4">
              <TextBlock Text="PCGW details" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" />
              <StackPanel Margin="12,0,0,0" Spacing="4">
                <TextBlock Text="Config (click to open)"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsConfigPathClickable}" />
                <TextBlock Text="Config (registry)"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsConfigPathIsRegistry}" />
                <TextBlock Text="Config"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsConfigPathDisplayOnly}" />
                <TextBlock Text="{Binding DetailsConfigPath}"
                           Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap" Cursor="Hand"
                           PointerPressed="OpenConfigPath_PointerPressed"
                           IsVisible="{Binding DetailsConfigPathClickable}" />
                <TextBlock Text="{Binding DetailsConfigPath}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsConfigPathDisplayOnly}" />
                <TextBlock Text="{Binding DetailsConfigPath}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsConfigPathIsRegistry}" />
                <TextBlock Text="Saves (click to open)"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsSavePathClickable}" />
                <TextBlock Text="Saves"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsSavePathDisplayOnly}" />
                <TextBlock Text="{Binding DetailsSavePath}"
                           Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap" Cursor="Hand"
                           PointerPressed="OpenSavePath_PointerPressed"
                           IsVisible="{Binding DetailsSavePathClickable}" />
                <TextBlock Text="{Binding DetailsSavePath}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsSavePathDisplayOnly}" />
                <TextBlock Text="Video"
                           Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}"
                           IsVisible="{Binding DetailsVideo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsVideo}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsVideo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding DetailsCommandLine}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DetailsCommandLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding DetailsExePath, StringFormat='Executable: {0}'}"
                       Foreground="{DynamicResource TextSuccess}" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeLabel}" Margin="0,12,0,0"
                       IsVisible="{Binding HasGameSelected}" />
            <TextBlock Text="{Binding DetailsExeModified, StringFormat='Modified: {0}'}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeLabel}"
                       Margin="0,2,0,0"
                       IsVisible="{Binding HasGameSelected}" />
            <TextBlock Text="{Binding MultipleExeWarning}"
                       Foreground="{DynamicResource TextDanger}" FontSize="{DynamicResource FontSizeLabel}"
                       TextWrapping="Wrap" Cursor="Hand" Margin="0,4,0,0"
                       PointerPressed="MultipleExeWarning_PointerPressed"
                       IsVisible="{Binding HasMultipleExes}" />

            <TextBlock Text="Press F4 to configure this entry."
                       Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}" Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasGameSelected}" />
            <TextBlock Text="No item selected — use arrow keys to navigate."
                       Foreground="{DynamicResource TextDisabled}" FontStyle="Italic" FontSize="{DynamicResource FontSizeBody}" Margin="0,16,0,0"
                       IsVisible="{Binding !HasSelection}" />
          </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding ConfiguredRootsCount}" Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeLabel}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="pane" Padding="10" Margin="0,10,0,10">
      <Grid>
        <TextBlock Classes="status-line" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,280,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="{Binding LookupQueueText}"
                     Foreground="{DynamicResource TextMuted}"
                     FontSize="{DynamicResource FontSizeLabel}"
                     IsVisible="{Binding LookupQueueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock x:Name="LookupStatusChip"
                     Text="{Binding LookupStatusText}"
                     FontSize="{DynamicResource FontSizeLabel}" FontWeight="Bold" />
        </StackPanel>
      </Grid>
    </Border>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding Commands}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" ItemWidth="120" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ShellCommandViewModel">
          <Border Background="{DynamicResource CommandButtonBg}" Padding="6" Margin="0,0,8,8"
                  Tag="{Binding Hotkey}" PointerPressed="CommandButtonPressed">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Hotkey}" Foreground="{DynamicResource TextHighlight}" FontWeight="Bold" />
              <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>

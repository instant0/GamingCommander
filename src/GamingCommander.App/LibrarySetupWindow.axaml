<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamingCommander.App.ViewModels"
        x:Class="GamingCommander.App.LibrarySetupWindow"
        x:DataType="vm:LibrarySetupViewModel"
        Title="Library Root Setup"
        Width="650"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Library Root Setup" FontWeight="Bold" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource TextAccent}" />
      <TextBlock Text="Add, remove, or rescan library roots. Changes apply immediately."
                 Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Background="{DynamicResource PaneBg}" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="ScanStatusText" Grid.Row="0" Foreground="{DynamicResource TextSuccess}" FontSize="{DynamicResource FontSizeLabel}"
                   Margin="0,0,0,4" Text="" />
        <ScrollViewer Grid.Row="1">
          <StackPanel x:Name="RootsPanel" Spacing="0" />
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AddRootButton" Content="+ Add Root" Background="{DynamicResource ButtonBgAction}" Foreground="{DynamicResource TextAccent}"
              Padding="16,8" />
      <Button x:Name="CloseButton" Content="Close" Background="{DynamicResource ButtonBgSecondary}" Foreground="{DynamicResource TextAccent}"
              Padding="20,8" />
    </StackPanel>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GamingCommander.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.12" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\blacklist.json" Link="data\blacklist.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\tag_colors.json" Link="data\tag_colors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\GamingCommander.Readme.txt" Link="GamingCommander.Readme.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Bug 16: ship blacklist.json as an embedded resource so a wiped/missing user
         data/ copy can be restored (or loaded in-memory) without manual re-copy. -->
    <EmbeddedResource Include="..\..\data\blacklist.json" LogicalName="GamingCommander.App.data.blacklist.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamingCommander.Core\GamingCommander.Core.csproj" />
    <ProjectReference Include="..\GamingCommander.UI\GamingCommander.UI.csproj" />
    <ProjectReference Include="..\GamingCommander.Detection\GamingCommander.Detection.csproj" />
    <ProjectReference Include="..\GamingCommander.Migration\GamingCommander.Migration.csproj" />
  </ItemGroup>

  <!-- Host files stay at publish root. Everything else managed/native goes to lib/. -->
  <Target Name="OrganizePublishLayout" AfterTargets="Publish">
    <PropertyGroup>
      <_Pub>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_Pub>
      <_Lib>$(_Pub)lib</_Lib>
    </PropertyGroup>
    <MakeDir Directories="$(_Lib)" />
    <ItemGroup>
      <_Stay Include="$(_Pub)GamingCommander.App.exe" />
      <_Stay Include="$(_Pub)GamingCommander.App.dll" />
      <_Stay Include="$(_Pub)GamingCommander.App.runtimeconfig.json" />
      <_Stay Include="$(_Pub)GamingCommander.App.deps.json" />
      <_Stay Include="$(_Pub)GamingCommander.Readme.txt" />
      <_Move Include="$(_Pub)*.dll" Exclude="$(_Pub)GamingCommander.App.dll" />
      <_Move Include="$(_Pub)*.pdb" />
    </ItemGroup>
    <Move SourceFiles="@(_Move)" DestinationFolder="$(_Lib)" Condition="'@(_Move)' != ''" />
  </Target>
</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GamingCommander.App.GameSetupWindow"
        Title="Configure Game"
        Width="760"
        Height="820"
        MinWidth="560"
        MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" Margin="20">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock x:Name="TitleText" Text="Configure Game" FontWeight="Bold" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource TextAccent}" />
      <TextBlock x:Name="SubtitleText" Text="" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeLabel}" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
      <StackPanel x:Name="FieldsPanel" Spacing="10" />
    </ScrollViewer>
  </Grid>
</Window>

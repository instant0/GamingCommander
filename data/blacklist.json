{
  "$schema": "GamingCommander blacklist registry — loaded at startup by C# bootstrapper",
  "version": 1,
  "description": "Aggregated noise patterns from Python research tools, consumed by C# implementation for safe game detection and metadata lookup.",
  "future": "See planning/91-user-blacklist-editor.md for planned interactive blacklist editing UI in VFS browser.",

  "exe_name_patterns": {
    "description": "Executable filenames containing these substrings are NOT game executables. Applied as case-insensitive substring match against the full filename.",
    "tier_1_universal_noise": [
      "cleanup", "touchup", "crash", "installer", "unins",
      "uninstall", "unwise", "setup", "redist", "vcredist", "dxsetup",
      "oalinst", "dotnet", "directx", "physx",
      "msi", "msiexec", "xna", "ndp", "dotnetfx",
      "asksavegames", "delsaves"
    ],
    "tier_2_launcher_stubs": [
      "updater", "patcher", "startup", "bootstrapper"
    ],
    "tier_3_store_bootstraps": [
      "galaxy", "gog", "epic", "uplay", "ubisoft"
    ],
    "tier_4_anticheat_drm": [
      "easyanticheat", "battleye", "beclient", "beservice", "equ8",
      "punkbuster", "nprotect", "xigncode", "denuvo", "vmprotect"
    ],
    "tier_5_error_crash_reporting": [
      "crash", "error", "crs-", "bugsplat", "unrealcefsubprocess"
    ],
    "tier_6_drm_wrappers": [
      "xlive"
    ],
    "tier_7_installer_utilities": [
      "autorun", "7za", "xdelta"
    ],
    "tier_8_server_loader_stub": [
      "dedicatedserver", "stub", "update", "loader", "browser", "dowser"
    ],
    "tier_9_distribution_tools": [
      "sdcr", "tachyon", "movie", "intro"
    ],
    "tier_10_dev_editor_tools": [
      "datacompiler", "editor", "modmanager", "packagemanager", "reminder",
      "contented", "leveled", "resourceed",
      "builder", "worldbuilder", "configtool"
    ],
    "tier_11_utilities_debug": [
      "install", "debug", "utils", "sndrpt", "exception", "explorer",
      "brwc", "activation", "ccmini", "acpc"
    ],
    "tier_12_trial_demo_stub": [
      "trial", "_upp"
    ],
    "tier_13_media_codec_tools": [
      "ffmpeg", "ffplay", "ffprobe"
    ],
    "tier_14_installer_frameworks": [
      "squirrel", "wininst", "w9xpopen"
    ],
    "tier_15_runtime_interpreters": [
      "python", "blender"
    ],
    "tier_16_web_ui_overlay": [
      "coherentui", "cefhost", "awesomium", "webview", "overlay", "scummvm"
    ],
    "tier_17_repair_service_helper": [
      "repair", "service", "helper"
    ],
    "tier_18_unreal_build_tools": [
      "unrealpak"
    ],
    "tier_19_patch_update": [
      "patch"
    ],
    "tier_20_utility_tools": [
      "winscp", "activate"
    ],
    "_test_cases": [
      {"filename": "galaxy_no_mans_sky_2.12.0.15.exe",  "expected_noise": true,  "reason": "contains 'galaxy' — GOG Galaxy stub"},
      {"filename": "NMS.exe",                            "expected_noise": false, "reason": "actual game executable"},
      {"filename": "oalinst.exe",                        "expected_noise": true,  "reason": "contains 'oalinst' — OpenAL installer"},
      {"filename": "dxwebsetup.exe",                     "expected_noise": true,  "reason": "contains 'setup' — installer"},
      {"filename": "easyanticheat_setup.exe",            "expected_noise": true,  "reason": "contains 'easyanticheat' and 'setup' — anti-cheat installer"},
      {"filename": "ES2-Win64-Shipping.exe",             "expected_noise": false, "reason": "game exe (UE4 shipping build)"},
      {"filename": "vcredist_x64.exe",                   "expected_noise": true,  "reason": "contains 'vcredist' — VC++ redistributable"},
      {"filename": "crs-handler.exe",                    "expected_noise": true,  "reason": "contains 'crs-' — crash reporter suite"},
      {"filename": "crs-uploader.exe",                   "expected_noise": true,  "reason": "contains 'crs-' — crash reporter suite"},
      {"filename": "BsSndRpt.exe",                       "expected_noise": true,  "reason": "contains 'bugsplat' — BugSplat reporter"},
      {"filename": "BugSplatHD.exe",                     "expected_noise": true,  "reason": "contains 'bugsplat' — BugSplat reporter"},
      {"filename": "xlive_start.exe",                    "expected_noise": true,  "reason": "contains 'xlive' — GFWL wrapper"},
      {"filename": "Autorun.exe",                        "expected_noise": true,  "reason": "contains 'autorun' — CD autorun"},
      {"filename": "7za.exe",                            "expected_noise": true,  "reason": "contains '7za' — 7-Zip archiver"},
      {"filename": "xdelta3-3.1.0.x86-64.exe",           "expected_noise": true,  "reason": "contains 'xdelta' — binary patch tool"},
      {"filename": "nwn2server.exe",                     "expected_noise": true,  "reason": "contains 'server' — dedicated server"},
      {"filename": "DebugServer.exe",                    "expected_noise": true,  "reason": "contains 'server' — debug server"},
      {"filename": "nwn2stub.exe",                       "expected_noise": true,  "reason": "contains 'stub' — exe stub"},
      {"filename": "nwupdate.exe",                       "expected_noise": true,  "reason": "contains 'update' — update tool"},
      {"filename": "nwloader.exe",                       "expected_noise": true,  "reason": "contains 'loader' — loader tool"},
      {"filename": "BlizzardBrowser.exe",                "expected_noise": true,  "reason": "contains 'browser' — browser helper process"},
      {"filename": "dowser.exe",                         "expected_noise": true,  "reason": "contains 'dowser' — Paradox launcher"},
      {"filename": "SDCR64.exe",                         "expected_noise": true,  "reason": "contains 'sdcr' — Stardock distribution tool"},
      {"filename": "tachyon.exe",                        "expected_noise": true,  "reason": "contains 'tachyon' — Stardock HTML renderer"},
      {"filename": "DataCompiler.exe",                   "expected_noise": true,  "reason": "contains 'datacompiler' — data compiler tool"},
      {"filename": "GalCiv3FlavorTextEditor.exe",        "expected_noise": true,  "reason": "contains 'editor' — content editor"},
      {"filename": "ContentEd.exe",                      "expected_noise": true,  "reason": "contains 'contented' — content editor tool"},
      {"filename": "ModManager.exe",                     "expected_noise": true,  "reason": "contains 'modmanager' — mod manager"},
      {"filename": "PackageManager.exe",                 "expected_noise": true,  "reason": "contains 'packagemanager' — package tool"},
      {"filename": "RegistrationReminder.exe",           "expected_noise": true,  "reason": "contains 'reminder' — nag/notification tool"},
      {"filename": "RiftApart.exe",                      "expected_noise": false, "reason": "actual game exe"},
      {"filename": "DaysGone.exe",                       "expected_noise": false, "reason": "actual game exe"},
      {"filename": "BsSndRpt.exe",                       "expected_noise": true,  "reason": "contains 'sndrpt' — BugSplat send report"},
      {"filename": "GDFInstall.exe",                     "expected_noise": true,  "reason": "contains 'install' — installer utility"},
      {"filename": "AowPF_Debug.exe",                    "expected_noise": true,  "reason": "contains 'debug' — debug build"},
      {"filename": "GCUtils.exe",                        "expected_noise": true,  "reason": "contains 'utils' — utility tool"},
      {"filename": "BRException.exe",                    "expected_noise": true,  "reason": "contains 'exception' — exception handler"},
      {"filename": "RegGExplorer.exe",                   "expected_noise": true,  "reason": "contains 'explorer' — registry explorer"},
      {"filename": "ContentEd.exe",                      "expected_noise": true,  "reason": "contains 'contented' — content editor tool"},
      {"filename": "LevelEd.exe",                        "expected_noise": true,  "reason": "contains 'leveled' — level editor tool"},
      {"filename": "ResourceEd.exe",                     "expected_noise": true,  "reason": "contains 'resourceed' — resource editor tool"},
      {"filename": "brwc.exe",                           "expected_noise": true,  "reason": "contains 'brwc' — BitRaider web client"},
      {"filename": "ActivationUI.exe",                   "expected_noise": true,  "reason": "contains 'activation' — activation/DRM tool"},
      {"filename": "CCMini.exe",                         "expected_noise": true,  "reason": "contains 'ccmini' — Chinese chat utility"},
      {"filename": "acpc.exe",                           "expected_noise": true,  "reason": "contains 'acpc' — unknown utility"},
      {"filename": "bf1Trial.exe",                       "expected_noise": true,  "reason": "contains 'trial' — trial/demo version"},
      {"filename": "GRB_UPP.exe",                        "expected_noise": true,  "reason": "contains '_upp' — Ubisoft Premium sub service"},
      {"filename": "GRB_vulkan.exe",                     "expected_noise": false, "reason": "vulkan render variant — actual game exe"},
      {"filename": "ACOrigins.exe",                      "expected_noise": false, "reason": "Assassin's Creed Origins — actual game exe (NOT filtered by 'origin')"},
      {"filename": "ffmpeg.exe",                         "expected_noise": true,  "reason": "contains 'ffmpeg' — media codec tool"},
      {"filename": "squirrel.exe",                       "expected_noise": true,  "reason": "contains 'squirrel' — Squirrel installer framework"},
      {"filename": "python.exe",                         "expected_noise": true,  "reason": "contains 'python' — Python interpreter"},
      {"filename": "blender-2.42-windows.exe",           "expected_noise": true,  "reason": "contains 'blender' — Blender 3D suite"},
      {"filename": "coherentui_host.exe",                "expected_noise": true,  "reason": "contains 'coherentui' — web UI framework"},
      {"filename": "cefhost.exe",                        "expected_noise": true,  "reason": "contains 'cefhost' — CEF host process"},
      {"filename": "awesomium_process.exe",              "expected_noise": true,  "reason": "contains 'awesomium' — web UI framework"},
      {"filename": "arcwebviewrender.exe",               "expected_noise": true,  "reason": "contains 'webview' — web view renderer"},
      {"filename": "arcoverlay.exe",                     "expected_noise": true,  "reason": "contains 'overlay' — overlay process"},
      {"filename": "scummvm.exe",                        "expected_noise": true,  "reason": "contains 'scummvm' — ScummVM emulator"},
      {"filename": "arcrepair.exe",                      "expected_noise": true,  "reason": "contains 'repair' — repair tool"},
      {"filename": "arcservice.exe",                     "expected_noise": true,  "reason": "contains 'service' — service process"},
      {"filename": "helper.exe",                         "expected_noise": true,  "reason": "contains 'helper' — helper process"},
      {"filename": "unrealpak.exe",                      "expected_noise": true,  "reason": "contains 'unrealpak' — Unreal Pak tool"},
      {"filename": "wininst-9.0-amd64.exe",              "expected_noise": true,  "reason": "contains 'wininst' — Python install helper"},
      {"filename": "w9xpopen.exe",                       "expected_noise": true,  "reason": "contains 'w9xpopen' — Python subprocess launcher"},
      {"filename": "GRB_UPP.exe",                        "expected_noise": true,  "reason": "contains '_upp' — Ubisoft Premium sub service"},
      {"filename": "GRB_vulkan.exe",                     "expected_noise": false, "reason": "vulkan render variant — actual game exe"},
      {"filename": "RainbowSix_BE.exe",                  "expected_noise": false, "reason": "BattlEye variant — actual game exe"},
      {"filename": "ffplay.exe",                         "expected_noise": true,  "reason": "contains 'ffplay' — ffmpeg media player"},
      {"filename": "ffprobe.exe",                        "expected_noise": true,  "reason": "contains 'ffprobe' — ffmpeg probe tool"},
      {"filename": "patch_star_control_origins.exe",     "expected_noise": true,  "reason": "contains 'patch' — patch installer"},
      {"filename": "Patch.exe",                          "expected_noise": true,  "reason": "contains 'patch' — generic patch exe"},
      {"filename": "-WinSCP.exe",                        "expected_noise": true,  "reason": "contains 'winscp' — WinSCP file transfer tool"},
      {"filename": "Activate.exe",                       "expected_noise": true,  "reason": "contains 'activate' — activation tool"},
      {"filename": "u9patch118.exe",                     "expected_noise": true,  "reason": "contains 'patch' — game patch, not the game itself"},
      {"filename": "CrashReport.exe",                    "expected_noise": true,  "reason": "contains 'crash' — crash reporter"},
      {"filename": "UnityCrashHandler64.exe",            "expected_noise": true,  "reason": "contains 'crash' — Unity crash handler"},
      {"filename": "BlizzardError.exe",                  "expected_noise": true,  "reason": "contains 'error' — Blizzard error reporter"},
      {"filename": "FortniteClient-Win64-Shipping_EAC_EOS.exe", "expected_noise": false, "reason": "actual game exe (EOS integration)"},
      {"filename": "AoW3Launcher.exe",                   "expected_noise": false, "reason": "legitimate game launcher (scored, not filtered)"},
      {"filename": "Launcher.exe",                       "expected_noise": false, "reason": "could be legitimate game launcher (scored, not filtered)"}
    ]
  },

  "directory_patterns": {
    "description": "Directories matching these substrings are skipped entirely during executable scanning. They contain redistributables, installers, and support files.",
    "patterns": [
      "__redist", "_commonredist", "redist", "redistributable", "directx", "vcredist",
      "dotnet", "jdk", "physx", "support", "_installer", "install", "installer"
    ],
    "_test_cases": [
      {"dirname": "__redist",   "expected_skip": true,  "reason": "Epic/GOG redistributable folder"},
      {"dirname": "_CommonRedist", "expected_skip": true, "reason": "Steam common redistributable folder"},
      {"dirname": "Redistributable", "expected_skip": true, "reason": "Bug 13a — generic redistributable folder"},
      {"dirname": "jdk-17",     "expected_skip": true,  "reason": "Bug 13a — Java JDK runtime folder"},
      {"dirname": "Binaries",   "expected_skip": false, "reason": "game binary folder (should NOT be skipped)"}
    ]
  },

  "pe_metadata_blacklist": {
    "description": "PE FileDescription/ProductName values containing these substrings are NOT used as internet search terms. Matches Unreal Engine defaults and other generic placeholders.",
    "patterns": [
      "appname", "application", "my application", "my project",
      "game", "launcher", "unreal", "unreal engine",
      "shipping", "development", "debug", "test",
      "ue4", "ue5", "unrealengine"
    ],
    "_test_cases": [
      {"value": "AppName",                              "expected_blocked": true,  "reason": "Unreal Engine default"},
      {"value": "Saints Row: The Third Remastered",     "expected_blocked": false, "reason": "valid game name"},
      {"value": "Application",                          "expected_blocked": true,  "reason": "generic placeholder"}
    ]
  },

  "pcgw_page_title_noise": {
    "description": "PCGamingWiki page titles containing these substrings are unlikely to be actual game pages. Used as scoring penalty in multi-result OpenSearch matching.",
    "patterns": [
      "digital book", "soundtrack", "demo", "benchmark",
      "tool", "sdk", "editor", "launcher", "art book",
      "artbook", "bundle", "beta", "prototype", "original soundtrack",
      "comic", "comic book", "making of", "behind the scenes",
      "strategy guide", "manual", "instruction manual",
      "trailer", "teaser", "wallpaper", "avatar"
    ],
    "_test_cases": [
      {"title": "Tomb Raider - The Final Hours Digital Book", "expected_penalty": true,  "reason": "contains 'digital book' — not a game"},
      {"title": "Tomb Raider (2013)",                         "expected_penalty": false, "reason": "actual game page"}
    ]
  }
}
